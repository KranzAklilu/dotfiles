set $mod Mod4

include ~/.config/sway/workspaces.conf
include ~/.config/sway/theme.conf

font pango:monospace 10.000000
floating_modifier $mod
default_border normal 2
default_floating_border normal 2
floating_minimum_size 75 x 50
floating_maximum_size 1000 x 750
hide_edge_borders none
focus_wrapping yes
focus_follows_mouse yes
focus_on_window_activation smart
mouse_warping output
client.focused #4c7899 #285577 #ffffff #2e9ef4 #285577
client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
client.unfocused #333333 #222222 #888888 #292d2e #222222
client.urgent #2f343a #900000 #ffffff #900000 #900000
client.placeholder #000000 #0c0c0c #ffffff #000000 #0c0c0c
client.background #ffffff
gaps inner 3

# main
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Return exec alacritty

# move
bindsym $mod+Shift+l move right 30px
bindsym $mod+Shift+h move left 30px
bindsym $mod+Shift+k move up 30px
bindsym $mod+Shift+j move down 30px
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up

bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you want to exit sway?' -b 'Yes' 'swaymsg exit'
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+t floating toggle
bindsym $mod+x layout toggle split tabbed stacking

bindsym $mod+a focus parent
bindsym $mod+d exec rofi -no-config -no-lazy-grab -show drun -modi drun
bindsym $mod+Shift+s exec rofi-screenshot -theme ~/.config/rofi/theme.rasi
bindsym $mod+e layout toggle split
bindsym $mod+q layout stacking
bindsym $mod+f fullscreen toggle
bindsym $mod+minus scratchpad show
# bindsym $mod+Shift+r mode resize
bindsym $mod+r exec ~/.local/bin/whisper-type
bindsym $mod+space focus mode_toggle
bindsym $mod+v split v
bindsym $mod+w layout tabbed
bindsym $mod+j focus down
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+s exec slurp | grim -g - - | tee ~/Pictures/Screenshot/$(date +%s).png | wl-copy
bindsym $mod+Shift+x exec systemctl suspend & swaylock 

mode "resize" {
  bindsym Down resize grow height 10 px or 10 ppt
  bindsym Escape mode default
  bindsym Left resize shrink width 10 px or 10 ppt
  bindsym Return mode default
  bindsym Right resize grow width 10 px or 10 ppt
  bindsym Up resize shrink height 10 px or 10 ppt
}

input type:touchpad {
  natural_scroll  enabled
  tap  enabled
}
input type:keyboard {
  # xkb_layout "de"
  xkb_options ctrl:swapcaps
}

for_window [app_id="org.gnome.Nautilus"] floating enable
for_window [app_id="org.gnome.clocks"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable

# for_window [app_id="Renode"] move to workspace 7 renode
# for_window [app_id="Renode"] move to workspace 7; workspace 7;

# brightness
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl --min-val=5 -q -d amdgpu_bl1 s 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -q -d amdgpu_bl1 s 5%+

# volume
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# exporting all environments so that dbus works properly
exec_always dbus-update-activation-environment --systemd --all

exec --no-startup-id i3-msg 'workspace 10; exec alacritty'

exec swaync
exec waybar
exec swaymsg workspace 10
exec_always swaybg -i /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png -m fill
